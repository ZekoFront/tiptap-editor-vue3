{
    "name": "tiptap-editor-vue3",
    "version": "2.0.8",
    "description": "A vue3 high quality rich text editor",
    "keywords": [
        "Editor",
        "Rich Text",
        "Vue3-editor",
        "Web Rich Text"
    ],
    "license": "MIT",
    "author": "ZekoFront",
    "repository": {
        "type": "git",
        "url": "https://github.com/ZekoFront/tiptap-editor-vue3.git"
    },
    "style": "./dist/css/style.css",
    "files": [
        "dist/*",
        "LICENSE",
        "README.md",
        "package.json"
    ],
    "type": "module",
    "main": "./dist/tiptap-editor-vue3.umd.js",
    "module": "./dist/tiptap-editor-vue3.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/tiptap-editor-vue3.es.js",
            "require": "./dist/tiptap-editor-vue3.umd.js"
        },
        "./dist/css/style.css": "./dist/css/style.css"
    },
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build && vue-tsc -p tsconfig.build.json",
        "build:demo": "vue-tsc -b && vite build --config vite.demo.config.ts",
        "preview:demo": "vite preview --config vite.demo.config.ts --outDir dist-demo",
        "fmt": "oxfmt src",
        "fmt-check": "oxfmt --check src",
        "fmt-diff": "oxfmt --list-different",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "preview": "vite preview"
    },
    "dependencies": {
        "@floating-ui/dom": "^1.6.13",
        "@tiptap/core": "^3.18.0",
        "@tiptap/extension-blockquote": "^3.18.0",
        "@tiptap/extension-bold": "^3.18.0",
        "@tiptap/extension-bubble-menu": "^3.18.0",
        "@tiptap/extension-code": "^3.18.0",
        "@tiptap/extension-code-block": "^3.18.0",
        "@tiptap/extension-code-block-lowlight": "^3.18.0",
        "@tiptap/extension-collaboration": "^3.18.0",
        "@tiptap/extension-color": "3.18.0",
        "@tiptap/extension-drag-handle": "^3.18.0",
        "@tiptap/extension-drag-handle-vue-3": "^3.18.0",
        "@tiptap/extension-emoji": "^3.18.0",
        "@tiptap/extension-heading": "^3.18.0",
        "@tiptap/extension-highlight": "^3.18.0",
        "@tiptap/extension-horizontal-rule": "^3.18.0",
        "@tiptap/extension-image": "^3.18.0",
        "@tiptap/extension-link": "^3.18.0",
        "@tiptap/extension-list": "^3.18.0",
        "@tiptap/extension-node-range": "^3.18.0",
        "@tiptap/extension-subscript": "^3.18.0",
        "@tiptap/extension-superscript": "^3.18.0",
        "@tiptap/extension-table": "^3.18.0",
        "@tiptap/extension-text-align": "^3.18.0",
        "@tiptap/extension-text-style": "^3.18.0",
        "@tiptap/extension-underline": "^3.18.0",
        "@tiptap/extensions": "^3.18.0",
        "@tiptap/pm": "^3.18.0",
        "@tiptap/starter-kit": "^3.18.0",
        "@tiptap/suggestion": "^3.18.0",
        "@tiptap/vue-3": "^3.18.0",
        "@tiptap/y-tiptap": "^3.0.2",
        "@types/file-saver": "^2.0.7",
        "@vueuse/core": "^13.9.0",
        "dompurify": "^3.3.1",
        "file-saver": "^2.0.5",
        "hotkeys-js": "^3.13.15",
        "html-docx-js-typescript": "^0.1.5",
        "mammoth": "^1.12.0",
        "naive-ui": "^2.43.2",
        "unplugin-auto-import": "^21.0.0",
        "unplugin-vue-components": "^32.1.0",
        "uuid": "^14.0.0",
        "vue": "^3.5.34",
        "vue-cropper": "^1.1.4",
        "vue-i18n": "^11.4.4",
        "vue3-emoji-picker": "^1.1.8"
    },
    "devDependencies": {
        "@types/node": "^24.12.3",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vue/tsconfig": "^0.9.1",
        "oxfmt": "^0.51.0",
        "oxlint": "^1.66.0",
        "sass-embedded": "^1.100.0",
        "typescript": "~6.0.2",
        "vite": "^8.0.12",
        "vite-svg-loader": "^5.1.0",
        "vue-tsc": "^3.2.8"
    },
    "scope": "TiptapEditorVue3"
}
