{
    "extends": "./tsconfig.app.json",
    "compilerOptions": {
        "rootDir": "./src",
        "declaration": true,
        "emitDeclarationOnly": true,
        "declarationDir": "./dist",
        "noEmit": false,
        "outDir": "./dist"
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
    "exclude": ["src/playground/**/*"]
}
